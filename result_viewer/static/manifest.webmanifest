{
  "name": "Unit Raster Viewer",
  "short_name": "Rasters",
  "description": "Flip through per-unit rasters of exported recording sessions and keep a notebook per session",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f4f2",
  "theme_color": "#ffffff",
  "icons": [
    {
      "src": "/static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
